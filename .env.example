# Copy to .env.local and fill in. Never commit real values.

# Neon PostgreSQL connection string (pooled). From the Neon dashboard: Connect.
DATABASE_URL=

# Random secret used by Payload CMS to sign editor logins. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Production address of the site, used for canonical URLs. Leave empty on a preview.
NEXT_PUBLIC_SITE_URL=

# Keep false until launch acceptance passes. true allows search engines to index the site.
NEXT_PUBLIC_INDEXABLE=false

# Only for `npm run test:access` and `npm run test:community`. Must be a throwaway database, never the real one.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Community (questions, trip reports, activities)
# ---------------------------------------------------------------------------

# How email leaves the site: resend | capture | off.
#   resend  = really sent through Resend (needs RESEND_API_KEY and EMAIL_FROM).
#   capture = kept in the moderation test inbox (administrators only), nothing is sent. Allowed on a
#             developer's computer and on Vercel previews; refused on the production deployment.
#   off     = email not configured; sign-up stays closed.
# Left empty: capture on a developer's computer, off in production.
EMAIL_TRANSPORT=
# Only for a production build run on a test machine ("next start"), to allow capture there. Never on the live site.
ALLOW_EMAIL_CAPTURE=
# API key from the Resend dashboard (API Keys). Keep it secret.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, for example: Travel Notes <community@example.com>
EMAIL_FROM=
# Optional. Where replies to community email go.
EMAIL_REPLY_TO=

# Member photo storage in an S3-compatible bucket (for example Cloudflare R2).
# All four of bucket, endpoint, key id and secret must be set; otherwise uploads are switched off
# on Vercel (a serverless function has no permanent disk) and use the local media/ folder elsewhere.
S3_BUCKET=
# For R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Defaults to "auto" (correct for R2).
S3_REGION=

# Protects /cron/<job>. Vercel Cron sends it as "Authorization: Bearer <value>".
# Use a random string of at least 16 characters, e.g. openssl rand -hex 32. Without it the jobs do not run.
CRON_SECRET=

# Tests and local development only: multiplies the community rate limits (whole number, 1 or more).
# Ignored in production builds. Leave empty.
COMMUNITY_RATE_LIMIT_MULTIPLIER=
